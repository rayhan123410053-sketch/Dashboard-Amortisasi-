        "# Jalankan baris ini untuk mendeteksi port kosong secara otomatis dan meluncurkan ulang dashboard tanpa tabrakan port!\n",
        "from google.colab import output\n",
        "import threading\n",
        "import time\n",
        "import socket\n",
        "\n",
        "def temukan_port_kosong():\n",
        "    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
        "    sock.bind(('localhost', 0))\n",
        "    port = sock.getsockname()[1]\n",
        "    sock.close()\n",
        "    return port\n",
        "\n",
        "# Dapatkan port acak yang dipastikan kosong\n",
        "PORT_BEBAS = temukan_port_kosong()\n",
        "print(f\"Meluncurkan dashboard aman pada Port baru: {PORT_BEBAS}\")\n",
        "\n",
        "def run_shiny_dynamic():\n",
        "    try:\n",
        "        app.run(port=PORT_BEBAS)\n",
        "    except Exception as e:\n",
        "        print(f\"Gagal menjalankan di port {PORT_BEBAS}: {e}\")\n",
        "\n",
        "thread = threading.Thread(target=run_shiny_dynamic)\n",
        "thread.start()\n",
        "\n",
        "# Tunggu sistem siap\n",
        "time.sleep(2.5)\n",
        "\n",
        "# Tampilkan dashboard interaktif\n",
        "output.serve_kernel_port_as_iframe(PORT_BEBAS, height=800)"
